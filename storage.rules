rules_version = '2';

// Cloud Storage rules (plan, decision 15). Browsers may only drop booking photos into their own
// upload folder; createBooking (a Cloud Function, which these rules do not restrict) checks them and
// moves them into the booking's folder, and a scheduled clean-up deletes uploads never booked.
// The owner (an account with the `admin` claim) reads booking photos in the dashboard; customers
// manage the photos of their saved bikes.
service firebase.storage {
  match /b/{bucket}/o {
    // uploads/{uid}/{photoId}.jpg and {photoId}_thumb.jpg: the signed-in visitor (often an
    // anonymous guest session) creates files in their own folder only. Small JPEGs, and a photo id
    // of 20 lower-case letters or digits, as the site makes them.
    match /uploads/{uid}/{file} {
      // `resource == null`: only new files; an existing upload is never replaced.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && resource == null
        && file.matches('[a-z0-9]{20}(_thumb)?[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 2 * 1024 * 1024;
    }

    // Booking photos: the owner may look at them.
    match /bookings/{bookingId}/{file} {
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    // A customer's saved-bike photos (users/{uid}/bikes/{bikeId}/{photoId}.jpg and _thumb): the
    // customer adds, sees and deletes their own; the owner sees them. Signed-in accounts only, not
    // anonymous guest sessions. createBooking copies booking photos here too.
    match /users/{uid}/bikes/{bikeId}/{file} {
      allow read: if request.auth != null
        && ((request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous') || request.auth.token.admin == true);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && resource == null
        && file.matches('[a-z0-9]{20}(_thumb)?[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= 2 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Everything else stays closed to browsers.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
