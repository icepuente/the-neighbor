{
  "name": "the-neighbor",
  "version": "2.0.0",
  "private": true,
  "description": "The Neighbor: a mobile bike mechanic in Copenhagen. A static site and a small API that emails booking requests.",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "serve": "npm run vendor && node scripts/serve.js",
    "api": "node api/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node scripts/test-browser.js",
    "test:live": "node test/browser/live.js",
    "deploy": "bash scripts/deploy.sh",
    "export-texts": "node scripts/texts.js export",
    "import-texts": "node scripts/texts.js import",
    "build:pages": "node scripts/build-pages.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/dm-serif-display": "5.3.0"
  }
}
