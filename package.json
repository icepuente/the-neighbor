{
  "name": "bike-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Booking website for a mobile bike service",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:express": "node --watch server.js",
    "sync-shared": "node scripts/sync-shared.js && node scripts/sync-vendor.js",
    "dev": "npm run sync-shared && firebase emulators:start --only auth,firestore,functions,storage,hosting",
    "stop-emulators": "node scripts/stop-emulators.js",
    "test:functions": "node scripts/test-functions.js",
    "test:browser": "node scripts/test-browser.js",
    "test:demo": "node test/browser/demo.js",
    "seed": "node scripts/seed-demo.js",
    "set-owner": "node scripts/set-owner.js",
    "deploy:demo": "bash scripts/deploy-demo.sh",
    "test": "node --test \"test/*.test.js\"",
    "export-texts": "node scripts/texts.js export",
    "import-texts": "node scripts/texts.js import"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/dm-serif-display": "5.3.0",
    "firebase": "13.0.0",
    "firebase-tools": "^15.34.0"
  },
  "knip": {
    "ignoreDependencies": [
      "firebase-admin"
    ]
  }
}
