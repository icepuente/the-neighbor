{
  "name": "the-neighbor",
  "version": "2.0.0",
  "private": true,
  "description": "The Neighbor: a mobile bike mechanic in Copenhagen. A static site; repairs are booked by email.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:express": "node --watch server.js",
    "vendor": "node scripts/vendor.js",
    "serve": "npm run vendor && node scripts/serve.js",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "node scripts/test-browser.js",
    "test:live": "node test/browser/live.js",
    "deploy": "bash scripts/deploy.sh",
    "export-texts": "node scripts/texts.js export",
    "import-texts": "node scripts/texts.js import"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/dm-serif-display": "5.3.0"
  }
}
