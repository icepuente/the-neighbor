{
  "name": "bike-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Booking website for a mobile bike service",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:express": "node --watch server.js",
    "sync-shared": "node scripts/sync-shared.js",
    "dev": "npm run sync-shared && firebase emulators:start --only auth,firestore,functions,storage,hosting",
    "stop-emulators": "node scripts/stop-emulators.js",
    "test:functions": "node scripts/test-functions.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.13"
  },
  "devDependencies": {
    "firebase-tools": "^15.34.0"
  }
}
