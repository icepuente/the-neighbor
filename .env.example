# Public URL of the site (used in email links). https:// enables secure cookies.
PUBLIC_URL=https://book.icepuente.com

# Where new-booking notifications go, and the Reply-To on customer emails.
OWNER_EMAIL=you@example.com

# Admin login for /admin. Generate with: openssl rand -base64 18
ADMIN_PASSWORD=change-me
# Signs admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# SMTP. Leave SMTP_HOST empty in development to print emails to the console.
# These can live in a separate .env.smtp file (see docker-compose.yml).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. With Gmail this must be your address or a verified alias.
MAIL_FROM_ADDRESS=
