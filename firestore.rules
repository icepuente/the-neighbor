rules_version = '2';

// Firestore rules. Customers never read or write the database directly: the public site goes
// through Cloud Functions, which these rules do not restrict. The owner's dashboard (web/admin.html)
// reads and writes directly, as a signed-in account with the `admin` custom claim
// (scripts/set-owner.js). Customer accounts open their own data in phase 3.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isCustomer(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // Customer profiles: created by the Function syncAccount. The customer reads theirs and edits
    // their contact details; the owner reads all.
    match /users/{uid} {
      allow read: if isCustomer(uid) || isOwner();
      allow update: if isCustomer(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'address', 'apartment'])
        && shortText(request.resource.data.name, 100) && request.resource.data.name.size() > 0
        && shortText(request.resource.data.phone, 40) && shortText(request.resource.data.address, 200)
        && shortText(request.resource.data.apartment, 40);
    }

    // Bookings: the owner reads them and changes only their status and the owner's own note.
    // A signed-in customer reads their own (those made while signed in, or linked by syncAccount).
    match /bookings/{id} {
      allow read: if isOwner() || (resource.data.customerUid != null && isCustomer(resource.data.customerUid));
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerNote', 'statusAt'])
        && request.resource.data.status in ['pending', 'confirmed', 'completed', 'cancelled'];

      // Messages to the customer, written by the Function messageCustomer: the owner reads them.
      match /messages/{messageId} {
        allow read: if isOwner();
      }
    }

    // Business consultation requests: read, move along new -> contacted -> won / lost, and archive
    // (kept, but out of the main list) or restore.
    match /consultations/{id} {
      allow read: if isOwner();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ownerNote', 'archived'])
        && request.resource.data.status in ['new', 'contacted', 'won', 'lost']
        && (!('archived' in request.resource.data) || request.resource.data.archived is bool);
    }

    // Days the owner blocks: the document id is the date (YYYY-MM-DD).
    match /closedDates/{date} {
      allow read: if isOwner();
      allow create, update: if isOwner()
        && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['reason'])
        && (request.resource.data.reason is string && request.resource.data.reason.size() <= 100);
      allow delete: if isOwner();
    }

    // Care subscriptions and the email outbox: read only.
    match /subscriptions/{id} {
      allow read: if isOwner();
    }
    match /mail/{id} {
      allow read: if isOwner();
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
